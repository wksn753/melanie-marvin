# All of these values are server-side. Never use NEXT_PUBLIC_ for secrets.
# Optional for browsing the invitation; required to store REAL RSVPs.
DATABASE_URL=

# Required when DATABASE_URL is configured. Generate with: openssl rand -hex 32
RATE_LIMIT_SECRET=
# Trust only when a controlled proxy strips client-supplied X-Real-IP and sets its own.
TRUST_PROXY_HEADERS=false
# Recommended production canonical origin, e.g. https://wedding.example.com
SITE_ORIGIN=http://localhost:3000

# Keep private; >=32 random characters. Required only to export CSV through the API.
ADMIN_EXPORT_TOKEN=

# Optional Cloudflare Turnstile anti-bot protection. Configure BOTH keys for launch.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Privacy: allow search indexing only when site is ready to be publicly discovered.
ALLOW_INDEXING=false
